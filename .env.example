# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Application URL
NEXT_PUBLIC_APP_URL=https://octo-pi-nine.vercel.app

# Dodo Payments configuration (Test or Live mode)
DODO_PAYMENTS_API_KEY=your_dodo_api_key
DODO_PAYMENTS_WEBHOOK_SECRET=your_dodo_webhook_secret
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Dodo Payments Recurring Product IDs (Basic & Pro)
DODO_BASIC_WEEKLY_PRODUCT_ID=your_dodo_basic_weekly_product_id
DODO_BASIC_MONTHLY_PRODUCT_ID=your_dodo_basic_monthly_product_id
DODO_PRO_WEEKLY_PRODUCT_ID=your_dodo_pro_weekly_product_id
DODO_PRO_MONTHLY_PRODUCT_ID=your_dodo_pro_monthly_product_id

# Optional AI Resume Tailoring (Gemini or OpenAI)
# GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key
